{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "gold", "color": "#E5AB26", "name": "Brand gold" },
        { "slug": "gold-bar", "color": "#E4AA24", "name": "Gold utility bar" },
        { "slug": "teal", "color": "#37BFCB", "name": "Teal header" },
        { "slug": "teal-ink", "color": "#0E6B73", "name": "Teal text" },
        { "slug": "ink", "color": "#000000", "name": "Ink" },
        { "slug": "paper", "color": "#FFFFFF", "name": "Paper" },
        { "slug": "mist", "color": "#F9F9F9", "name": "Mist" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "manrope",
          "name": "Manrope",
          "fontFamily": "Manrope, \"Segoe UI\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Manrope",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/manrope-400.woff2"]
            },
            {
              "fontFamily": "Manrope",
              "fontWeight": "700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/manrope-700.woff2"]
            }
          ]
        }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "em", "%"],
      "spacingSizes": [
        { "slug": "20", "size": "16px", "name": "20" },
        { "slug": "30", "size": "24px", "name": "30" },
        { "slug": "40", "size": "32px", "name": "40" },
        { "slug": "50", "size": "48px", "name": "50" },
        { "slug": "60", "size": "72px", "name": "60" }
      ]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1200px"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--mist)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--manrope)",
      "fontSize": "17px",
      "lineHeight": "1.5"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "700",
          "letterSpacing": "-0.03em"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--gold)",
          "text": "#000000"
        },
        "border": { "radius": "4px" },
        "typography": { "fontWeight": "700" }
      }
    }
  }
}
